# Copy to .env and fill. Never commit .env.
ENV=dev                         # dev | demo
HF_TOKEN=
SGLANG_API_KEY=                 # optional; required if SGLang is not on 127.0.0.1
OFFERLENS_API_KEY=              # optional; enables X-API-Key on /api/*
TEACHER_MODEL=Qwen/Qwen2.5-7B-Instruct
TEACHER_REVISION=               # pin commit hash
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
BASE_REVISION=                  # pin commit hash
STUDENT_PATH=models/offerlens-1.5b-merged
TEACHER_PORT=30000
STUDENT_PORT=30001
BASE_PORT=30002
APP_PORT=8000
GPU_COST_INR_PER_HOUR=          # for cost_per_1k
# Hosted SGLang (deploy/modal_sglang.py). Full OpenAI base URL ending in /v1; unset = local ports above.
SGLANG_BASE_MODEL_URL=
SGLANG_STUDENT_URL=
# Fallback when no SGLang server answers. Unset = no fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DATA_COLLECTION=deny            # deny = only providers that don't store/train on prompts
